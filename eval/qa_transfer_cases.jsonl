{"case_id": "N01", "type": "single_fact", "question_zh": "按论文摘要统计，LOCOMO 对话平均多少轮、多少 Token，最多跨多少个会话？", "required_points": [{"id": "P1", "criterion": "每段对话平均约300轮，不能误写成总计或每会话300轮。", "refs": ["L-abstract"]}, {"id": "P2", "criterion": "每段对话平均约9K/9000 Token。", "refs": ["L-abstract"]}, {"id": "P3", "criterion": "最多跨35个会话，不能写成平均35个。", "refs": ["L-abstract"]}], "acceptable_equivalents": ["约300/300轮", "9K/9k/约9000 Token", "最多/至多35个会话"], "critical_errors": ["混淆每段对话与全数据集", "将上限说成平均或反之", "任一数量错误"], "allowed_documents": [{"versioned_source_id": "2402.17753v1", "sha256": "218188e1d66a553afe324491e3e5e5d0af107196c9ff32c65bb3640ebf638539", "page_count": 19}], "source_refs": {"L-abstract": {"versioned_source_id": "2402.17753v1", "pdf_page": 1, "pdf_sha256": "218188e1d66a553afe324491e3e5e5d0af107196c9ff32c65bb3640ebf638539", "url": "https://arxiv.org/pdf/2402.17753v1#page=1"}}}
{"case_id": "N03", "type": "single_fact", "question_zh": "RDF2Vec Light 的 Table 2 中，LP50 与 KORE 分别评价什么，使用什么指标？", "required_points": [{"id": "P1", "criterion": "LP50 是文档相关性任务。", "refs": ["R-table2"]}, {"id": "P2", "criterion": "LP50 报告 Pearson 相关与 Spearman 秩相关的调和平均。", "refs": ["R-table2"]}, {"id": "P3", "criterion": "KORE 是实体相关性任务。", "refs": ["R-table2"]}, {"id": "P4", "criterion": "KORE 使用余弦相似度。", "refs": ["R-table2"]}], "acceptable_equivalents": ["文档/文献相关性", "实体相关性", "皮尔逊相关和斯皮尔曼秩相关的调和均值", "cosine similarity/余弦相似度"], "critical_errors": ["交换LP50与KORE任务或指标", "将调和平均写成算术平均", "只列模型分数而不说明指标"], "allowed_documents": [{"versioned_source_id": "2009.07659v2", "sha256": "b258d66fc33481e7ac5f7f8656cd721b95246af0ae42fd86c1d8948e5a19c69a", "page_count": 5}], "source_refs": {"R-table2": {"versioned_source_id": "2009.07659v2", "pdf_page": 4, "pdf_sha256": "b258d66fc33481e7ac5f7f8656cd721b95246af0ae42fd86c1d8948e5a19c69a", "url": "https://arxiv.org/pdf/2009.07659v2#page=4"}}}
{"case_id": "N04", "type": "comparison", "question_zh": "LOCOMO 与 Mem2ActBench 分别怎样评价长期记忆，回答问题与使用记忆执行工具任务有什么区别？", "required_points": [{"id": "P1", "criterion": "LOCOMO 用长期多会话对话评价记忆；问答需从历史对话提取或推理答案。", "refs": ["L-abstract", "L-evaluation"]}, {"id": "P2", "criterion": "交代LOCOMO的评价方式，如问答对照标注答案计算F1，或说明还包含事件摘要与多模态对话生成；不能称它仅有简单事实提取。", "refs": ["L-abstract", "L-evaluation"]}, {"id": "P3", "criterion": "Mem2ActBench 要主动使用历史偏好/任务状态选择工具并准确填参数，评价工具调用而非仅生成自然语言答案。", "refs": ["M-abstract", "M-evaluation"]}, {"id": "P4", "criterion": "形成明确比较：记住并答对历史信息，不等于把记忆转化为正确工具和参数；Mem2ActBench有相应工具调用评价依据（F1、BLEU-1或TA至少一项准确解释即可）。", "refs": ["L-evaluation", "M-evaluation"]}], "acceptable_equivalents": ["不要求列全LOCOMO五种推理类别或全部评价指标", "TA=正确工具且全部参数严格匹配"], "critical_errors": ["把LOCOMO称为工具行动评测", "只介绍一篇或无明确比较", "将TA解释成只需工具名称正确", "说Mem2ActBench只测试被动事实问答"], "allowed_documents": [{"versioned_source_id": "2402.17753v1", "sha256": "218188e1d66a553afe324491e3e5e5d0af107196c9ff32c65bb3640ebf638539", "page_count": 19}, {"versioned_source_id": "2601.19935v1", "sha256": "c3901845afa60e74853d6e93686062da6a349cd828eb504d13fec287bdb46b91", "page_count": 17}], "source_refs": {"L-abstract": {"versioned_source_id": "2402.17753v1", "pdf_page": 1, "pdf_sha256": "218188e1d66a553afe324491e3e5e5d0af107196c9ff32c65bb3640ebf638539", "url": "https://arxiv.org/pdf/2402.17753v1#page=1"}, "L-evaluation": {"versioned_source_id": "2402.17753v1", "pdf_page": 5, "pdf_sha256": "218188e1d66a553afe324491e3e5e5d0af107196c9ff32c65bb3640ebf638539", "url": "https://arxiv.org/pdf/2402.17753v1#page=5"}, "M-abstract": {"versioned_source_id": "2601.19935v1", "pdf_page": 1, "pdf_sha256": "c3901845afa60e74853d6e93686062da6a349cd828eb504d13fec287bdb46b91", "url": "https://arxiv.org/pdf/2601.19935v1#page=1"}, "M-evaluation": {"versioned_source_id": "2601.19935v1", "pdf_page": 5, "pdf_sha256": "c3901845afa60e74853d6e93686062da6a349cd828eb504d13fec287bdb46b91", "url": "https://arxiv.org/pdf/2601.19935v1#page=5"}}}
{"case_id": "N05", "type": "comparison", "question_zh": "SICA 与 Lita 对代理代码、手工流程和任务执行的组织方式有什么不同？", "required_points": [{"id": "P1", "criterion": "SICA 在完整Python代理代码上自我改进，以历史代理归档及评测选择较优版本继续改代码。", "refs": ["S-method"]}, {"id": "P2", "criterion": "SICA 初始系统具有人为设计的工具、子代理与监督机制，代码/工具均可改进；不能说它完全无人工脚手架。", "refs": ["S-initial"]}, {"id": "P3", "criterion": "Lita 强调轻量、最少必要工具、避免复杂手工工作流/提示工程，由模型自主组织执行；不是SICA式代理自我改写循环。", "refs": ["T-principles", "T-components"]}, {"id": "P4", "criterion": "明确比较任务组织：SICA自改进与任务执行循环、工具/子代理协作；Lita通过工具/推理/记忆及统一任务环境驱动自主多轮执行，区分其目的和做法。", "refs": ["S-method", "S-initial", "T-components"]}], "acceptable_equivalents": ["无需逐一列出所有工具名", "用自改代码与最小脚手架自主执行作有证据比较可接受"], "critical_errors": ["声称SICA更新底模权重", "把Lita说成同样的递归自改代码框架", "声称Lita完全没有人工设计", "没有两篇各自的实际引用", "凭不同基准直接断言绝对性能优劣"], "allowed_documents": [{"versioned_source_id": "2504.15228v2", "sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "page_count": 18}, {"versioned_source_id": "2509.25873v1", "sha256": "b556c96bf1cfafbbfd03a923439566cd0d010ca439b487d2e265db32cccbdc94", "page_count": 18}], "source_refs": {"S-initial": {"versioned_source_id": "2504.15228v2", "pdf_page": 4, "pdf_sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "url": "https://arxiv.org/pdf/2504.15228v2#page=4"}, "S-method": {"versioned_source_id": "2504.15228v2", "pdf_page": 3, "pdf_sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "url": "https://arxiv.org/pdf/2504.15228v2#page=3"}, "T-components": {"versioned_source_id": "2509.25873v1", "pdf_page": 4, "pdf_sha256": "b556c96bf1cfafbbfd03a923439566cd0d010ca439b487d2e265db32cccbdc94", "url": "https://arxiv.org/pdf/2509.25873v1#page=4"}, "T-principles": {"versioned_source_id": "2509.25873v1", "pdf_page": 3, "pdf_sha256": "b556c96bf1cfafbbfd03a923439566cd0d010ca439b487d2e265db32cccbdc94", "url": "https://arxiv.org/pdf/2509.25873v1#page=3"}}}
{"case_id": "N06", "type": "comparison", "question_zh": "Generating with Confidence 中的语义分散度方法与 CCP 分别衡量什么层次的不确定性，需要哪些模型输出或访问条件？", "required_points": [{"id": "P1", "criterion": "语义分散度从同一输入的多条完整响应之间的语义差异/相似性估计输入或响应分布层面的不确定性，不等同于逐个事实真伪。", "refs": ["U-framework", "U-similarity"]}, {"id": "P2", "criterion": "该黑盒路线需要多次生成的文本，可借助额外NLI模型或规则相似度；不要求访问被测LLM的Token logits或Embedding。", "refs": ["U-framework", "U-similarity"]}, {"id": "P3", "criterion": "CCP 聚焦原子论断/词的信息取值不确定性，排除论断类型/顺序和表面措辞的不确定性。", "refs": ["C-levels"]}, {"id": "P4", "criterion": "CCP 需要生成词/Token的概率分布及候选，结合NLI区分同义/矛盾/中立后聚合为论断分数，不能仅凭黑盒回答文本实现。", "refs": ["C-access", "C-levels", "C-formula"]}], "acceptable_equivalents": ["不要求写全部图谱聚合公式或CCP精确公式", "将白盒条件解释为需Token概率访问即可，不要求权重本身公开"], "critical_errors": ["把语义分散度等同CCP或逐Token熵", "声称语义方法必须访问被测LLM logits", "声称CCP只需多条回答文本", "把NLI模型概率与目标LLM概率混为一谈", "没有两篇各自证据"], "allowed_documents": [{"versioned_source_id": "2305.19187v3", "sha256": "1f8de221ae0c3786a603e5e4e2a1b7c66514acde018d7274c9cd3a8d73c36dd0", "page_count": 28}, {"versioned_source_id": "2403.04696v2", "sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "page_count": 19}], "source_refs": {"C-access": {"versioned_source_id": "2403.04696v2", "pdf_page": 3, "pdf_sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "url": "https://arxiv.org/pdf/2403.04696v2#page=3"}, "C-formula": {"versioned_source_id": "2403.04696v2", "pdf_page": 6, "pdf_sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "url": "https://arxiv.org/pdf/2403.04696v2#page=6"}, "C-levels": {"versioned_source_id": "2403.04696v2", "pdf_page": 5, "pdf_sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "url": "https://arxiv.org/pdf/2403.04696v2#page=5"}, "U-framework": {"versioned_source_id": "2305.19187v3", "pdf_page": 4, "pdf_sha256": "1f8de221ae0c3786a603e5e4e2a1b7c66514acde018d7274c9cd3a8d73c36dd0", "url": "https://arxiv.org/pdf/2305.19187v3#page=4"}, "U-similarity": {"versioned_source_id": "2305.19187v3", "pdf_page": 5, "pdf_sha256": "1f8de221ae0c3786a603e5e4e2a1b7c66514acde018d7274c9cd3a8d73c36dd0", "url": "https://arxiv.org/pdf/2305.19187v3#page=5"}}}
{"case_id": "N07", "type": "method_condition", "question_zh": "SICA 怎样综合任务表现、成本和耗时选择后续版本？超时后的效用是否直接清零？", "required_points": [{"id": "P1", "criterion": "按综合效用选择归档中后续meta/base代理；性能权重0.5，成本和时间奖励各0.25，成本/时间越低奖励越高。", "refs": ["S-method"]}, {"id": "P2", "criterion": "成本以10美元、耗时以300秒归一化并截断奖励；300秒后取消任务。准确区分奖励截断与没有依据的成本硬停止承诺。", "refs": ["S-method"]}, {"id": "P3", "criterion": "超时后最终效用为基础效用乘(1-0.5)=0.5，保留部分成绩，不是直接清零；效用选版本，不是更新模型权重。", "refs": ["S-method"]}], "acceptable_equivalents": ["公式与等价文字均可", "0.5U/基础效用折半/50%部分效用"], "critical_errors": ["说超时直接清零或超时没有惩罚", "把时间项变0误当整体效用变0", "权重或归一化基准错误", "把效用用于梯度训练底模"], "allowed_documents": [{"versioned_source_id": "2504.15228v2", "sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "page_count": 18}], "source_refs": {"S-method": {"versioned_source_id": "2504.15228v2", "pdf_page": 3, "pdf_sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "url": "https://arxiv.org/pdf/2504.15228v2#page=3"}}}
{"case_id": "N08", "type": "method_condition", "question_zh": "RDF2Vec Light 的表现与实体连接度、同质性有什么关系？论文是否支持其在所有任务上都优于经典方法？", "required_points": [{"id": "P1", "criterion": "论文观察到目标实体连接度较高时Light表现较差，例如城市等高度连接实体。", "refs": ["R-conditions"]}, {"id": "P2", "criterion": "目标实体越同质、随机游走形成的子图越稠密，Light通常表现越好；这是实验相关性观察，非无条件定理。", "refs": ["R-conditions"]}, {"id": "P3", "criterion": "不支持所有任务均优于经典方法；给出具体限制或反例，如相关性任务中CBOW相当但SG经典方法更好，或城市任务明显落后。", "refs": ["R-table2", "R-conditions"]}], "acceptable_equivalents": ["用高连接head entities、同质实体和子图覆盖准确解释均可"], "critical_errors": ["连接度结论方向写反", "宣称所有任务均占优或绝对等价", "以节省时间代替对质量差异的回答"], "allowed_documents": [{"versioned_source_id": "2009.07659v2", "sha256": "b258d66fc33481e7ac5f7f8656cd721b95246af0ae42fd86c1d8948e5a19c69a", "page_count": 5}], "source_refs": {"R-conditions": {"versioned_source_id": "2009.07659v2", "pdf_page": 4, "pdf_sha256": "b258d66fc33481e7ac5f7f8656cd721b95246af0ae42fd86c1d8948e5a19c69a", "url": "https://arxiv.org/pdf/2009.07659v2#page=4"}, "R-table2": {"versioned_source_id": "2009.07659v2", "pdf_page": 4, "pdf_sha256": "b258d66fc33481e7ac5f7f8656cd721b95246af0ae42fd86c1d8948e5a19c69a", "url": "https://arxiv.org/pdf/2009.07659v2#page=4"}}}
{"case_id": "N09", "type": "insufficient_evidence", "question_zh": "Lita 提供哪些工具接口，其 SWE-bench 评测怎样配置？", "required_points": [{"id": "P1", "criterion": "明确目前允许材料是SICA而非Lita，缺少问题所指论文，不能由此核实Lita工具和SWE-bench配置。", "refs": ["S-method", "S-initial", "N09-absence-check"]}, {"id": "P2", "criterion": "具体指出需补Lita原论文/工具接口与评测设置，或请求提供对应文献；不凭模型记忆、其他题材料或把SICA工具冒充Lita。", "refs": ["N09-absence-check"]}], "acceptable_equivalents": ["拒绝未知结论本身无需引用证明不存在", "可引用SICA事实说明范围，但不能答成Lita事实"], "critical_errors": ["给出未经允许文献支持的Lita工具清单或配置", "引用SICA证明Lita事实", "仅说不知道而不说明材料缺口"], "allowed_documents": [{"versioned_source_id": "2504.15228v2", "sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "page_count": 18}], "source_refs": {"S-initial": {"versioned_source_id": "2504.15228v2", "pdf_page": 4, "pdf_sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "url": "https://arxiv.org/pdf/2504.15228v2#page=4"}, "S-method": {"versioned_source_id": "2504.15228v2", "pdf_page": 3, "pdf_sha256": "97781b82ed43a330f491a35f772360bc3a9e7b47c5817e8889a0e1fec1115a15", "url": "https://arxiv.org/pdf/2504.15228v2#page=3"}}}
{"case_id": "N10", "type": "insufficient_evidence", "question_zh": "根据论文，CCP 在中文客服场景中能检出多少比例的错误事实？", "required_points": [{"id": "P1", "criterion": "明确无法根据现有论文给出中文客服错误事实检出比例，不能把中文实验或PR-AUC直接当检出率。", "refs": ["C-benchmark", "C-metrics", "N10-absence-check"]}, {"id": "P2", "criterion": "说明目标场景缺口：缺少中文客服数据及事实标注/可比评测条件，若求检出率还需相应阈值或操作点；至少明确目标场景样本和实测/标注缺失。", "refs": ["C-benchmark", "C-metrics", "N10-absence-check"]}], "acceptable_equivalents": ["无需列全所有部署条件", "论文确有中文人物传记实验，可据此解释不能外推客服"], "critical_errors": ["编造或直接外推中文客服检出比例", "将PR-AUC解释成固定阈值检出比例", "错误声称论文完全没有中文实验", "仅说不知道而不指出场景/数据缺口"], "allowed_documents": [{"versioned_source_id": "2403.04696v2", "sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "page_count": 19}], "source_refs": {"C-benchmark": {"versioned_source_id": "2403.04696v2", "pdf_page": 6, "pdf_sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "url": "https://arxiv.org/pdf/2403.04696v2#page=6"}, "C-metrics": {"versioned_source_id": "2403.04696v2", "pdf_page": 7, "pdf_sha256": "e3ff23077ddb2fe828ec0011411afa23b09453a1d41a32a92cfbb466c6f7f880", "url": "https://arxiv.org/pdf/2403.04696v2#page=7"}}}
