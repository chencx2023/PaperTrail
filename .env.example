# PaperTrail configuration template. No API calls are made by this file.
# Copy to .env and fill in your own credentials; scripts load it on the server.
# Defaults below apply to the official DeepSeek API only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled

# Accepted two-stage answer profile. Agent selection/summaries stay non-thinking;
# only the outline and source review use high reasoning (up to 32768 output tokens).
PAPERTRAIL_GROUNDED_ANSWERS=true
PAPERTRAIL_GROUNDED_PROFILE=compact_repair
PAPERTRAIL_INSUFFICIENT_FACTS_COMPAT=true
PAPERTRAIL_CITATION_SCOPE_REVIEW=true
PAPERTRAIL_QA_REASONING=high
PAPERTRAIL_AGENT_TIMEOUT=500

# Alibaba Cloud Model Studio, Singapore region, OpenAI-compatible embeddings.
# Use a Singapore-region Model Studio API key, not a Qwen chat credential.
# Workspace-specific compatible-mode URLs may also be used.
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# The service accepts at most 10 texts per request; override lmi's default 16.
EMBEDDING_BATCH_SIZE=10
